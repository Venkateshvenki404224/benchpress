  "response_html": "<!--\n\tBenchPress Access Request Received — acknowledgement to the requester.\n\n\tTable layout, literal Cobalt hex, no <style> block and no custom properties: Outlook drops\n\tall three. This file is both the shipped fallback body and the seed for the Desk-editable\n\t`Email Template` row of the same name, so the two never drift.\n-->\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#F6F8FF;\">\n\t<tr>\n\t\t<td align=\"center\" style=\"padding:24px 12px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;\">\n\t\t\t<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:600px;background-color:#FFFFFF;border:1px solid #DFE7FA;border-radius:14px;\">\n\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:20px 28px;background-color:#0A1024;border-radius:13px 13px 0 0;\">\n\t\t\t\t\t\t<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td width=\"10\" bgcolor=\"#4E8BFB\" style=\"width:10px;height:10px;border-radius:3px;font-size:0;line-height:10px;\">&nbsp;</td>\n\t\t\t\t\t\t\t\t<td style=\"padding-left:12px;font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif;font-size:17px;font-weight:800;letter-spacing:0.04em;color:#FFFFFF;\">BENCHPRESS</td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t</table>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:30px 28px 0;\">\n\t\t\t\t\t\t<div style=\"font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#1F5CF5;\">Access request</div>\n\t\t\t\t\t\t<h1 style=\"margin:10px 0 0;font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif;font-size:24px;line-height:32px;font-weight:800;color:#0A1024;\">We have your request, {{ full_name | e }}.</h1>\n\t\t\t\t\t\t<p style=\"margin:14px 0 0;font-size:15px;line-height:24px;color:#4E5A7C;\">A person reads every access request — not a queue robot. Expect an answer within one business day, and a plain one either way.</p>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:22px 28px 0;\">\n\t\t\t\t\t\t<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#E8EEFF;border-radius:10px;\">\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td style=\"padding:14px 18px;\">\n\t\t\t\t\t\t\t\t\t<div style=\"font-size:11px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#4E5A7C;\">Your reference</div>\n\t\t\t\t\t\t\t\t\t<div style=\"padding-top:5px;font-family:'SFMono-Regular',Consolas,Menlo,monospace;font-size:17px;font-weight:700;color:#1F5CF5;\">{{ reference | e }}</div>\n\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t</table>\n\t\t\t\t\t\t<p style=\"margin:10px 0 0;font-size:13px;line-height:20px;color:#8B94AE;\">Quote it if you write to us. It is a handle, not a password — it unlocks nothing on its own.</p>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:24px 28px 0;\">\n\t\t\t\t\t\t<div style=\"font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#0A1024;\">What you told us</div>\n\t\t\t\t\t\t<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-top:10px;border-top:1px solid #E3EAFB;\">\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td width=\"150\" style=\"padding:9px 0;border-bottom:1px solid #E3EAFB;font-size:13px;line-height:20px;color:#8B94AE;\">Email</td>\n\t\t\t\t\t\t\t\t<td style=\"padding:9px 0;border-bottom:1px solid #E3EAFB;font-size:14px;line-height:20px;color:#0A1024;\">{{ email | e }}</td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t{% if company %}\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td width=\"150\" style=\"padding:9px 0;border-bottom:1px solid #E3EAFB;font-size:13px;line-height:20px;color:#8B94AE;\">Company</td>\n\t\t\t\t\t\t\t\t<td style=\"padding:9px 0;border-bottom:1px solid #E3EAFB;font-size:14px;line-height:20px;color:#0A1024;\">{{ company | e }}</td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t{% endif %}\n\t\t\t\t\t\t\t{% if team_size %}\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td width=\"150\" style=\"padding:9px 0;border-bottom:1px solid #E3EAFB;font-size:13px;line-height:20px;color:#8B94AE;\">Team size</td>\n\t\t\t\t\t\t\t\t<td style=\"padding:9px 0;border-bottom:1px solid #E3EAFB;font-size:14px;line-height:20px;color:#0A1024;\">{{ team_size | e }}</td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t{% endif %}\n\t\t\t\t\t\t\t{% if intent %}\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td width=\"150\" style=\"padding:9px 0;border-bottom:1px solid #E3EAFB;font-size:13px;line-height:20px;color:#8B94AE;\">Here for</td>\n\t\t\t\t\t\t\t\t<td style=\"padding:9px 0;border-bottom:1px solid #E3EAFB;font-size:14px;line-height:20px;color:#0A1024;\">{{ intent | e }}</td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t{% endif %}\n\t\t\t\t\t\t\t{% if expected_apps %}\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td width=\"150\" style=\"padding:9px 0;border-bottom:1px solid #E3EAFB;font-size:13px;line-height:20px;color:#8B94AE;\">Apps</td>\n\t\t\t\t\t\t\t\t<td style=\"padding:9px 0;border-bottom:1px solid #E3EAFB;font-size:14px;line-height:20px;color:#0A1024;\">{{ expected_apps | e }}</td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t{% endif %}\n\t\t\t\t\t\t\t{% if use_case %}\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td width=\"150\" valign=\"top\" style=\"padding:9px 0;border-bottom:1px solid #E3EAFB;font-size:13px;line-height:20px;color:#8B94AE;\">Use case</td>\n\t\t\t\t\t\t\t\t<td style=\"padding:9px 0;border-bottom:1px solid #E3EAFB;font-size:14px;line-height:20px;color:#0A1024;\">{{ use_case }}</td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t{% endif %}\n\t\t\t\t\t\t</table>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:26px 28px 0;\">\n\t\t\t\t\t\t<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#0A1024;border-radius:12px;\">\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td style=\"padding:20px 22px;\">\n\t\t\t\t\t\t\t\t\t<div style=\"font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif;font-size:16px;line-height:24px;font-weight:700;color:#FFFFFF;\">Do not wait on us if you have a server.</div>\n\t\t\t\t\t\t\t\t\t<p style=\"margin:8px 0 0;font-size:14px;line-height:22px;color:#9FC3FF;\">Self-hosting is the same code with no account, no approval and no ceiling on labs. Clone the repo and run <span style=\"font-family:'SFMono-Regular',Consolas,Menlo,monospace;\">./setup.sh</span>.</p>\n\t\t\t\t\t\t\t\t\t<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-top:16px;\">\n\t\t\t\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t\t\t\t<td bgcolor=\"#1F5CF5\" style=\"border-radius:10px;\">\n\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"{{ repo_url | e }}\" style=\"display:inline-block;padding:12px 20px;font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;font-weight:700;color:#FFFFFF;text-decoration:none;\">Self-host it instead</a>\n\t\t\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t\t</table>\n\t\t\t\t\t\t\t\t\t<p style=\"margin:12px 0 0;font-family:'SFMono-Regular',Consolas,Menlo,monospace;font-size:12px;line-height:19px;color:#9FC3FF;\"><a href=\"{{ repo_url | e }}\" style=\"color:#9FC3FF;text-decoration:none;\">{{ repo_url | e }}</a></p>\n\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t</table>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:22px 28px 0;\">\n\t\t\t\t\t\t<p style=\"margin:0;font-size:14px;line-height:22px;color:#4E5A7C;\">Reading while you wait: <a href=\"{{ docs_url | e }}\" style=\"color:#1F5CF5;text-decoration:underline;\">{{ docs_url | e }}</a></p>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:24px 28px 0;\">\n\t\t\t\t\t\t<div style=\"height:1px;background-color:#E3EAFB;line-height:1px;font-size:0;\">&nbsp;</div>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:16px 28px 26px;\">\n\t\t\t\t\t\t<p style=\"margin:0;font-size:12px;line-height:19px;color:#8B94AE;\">Sent by <a href=\"{{ site_url | e }}\" style=\"color:#4E5A7C;text-decoration:underline;\">BenchPress</a> because someone asked for hosted access with this address. Frappe and ERPNext are trademarks of Frappe Technologies Pvt. Ltd. BenchPress is an independent project, not affiliated with Frappe Technologies.</p>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\n\t\t\t</table>\n\t\t</td>\n\t</tr>\n</table>\n"
