  "response_html": "<!--\n\tBenchPress Access Declined — the plain answer the signup page promises instead of silence.\n\n\tNever explains the person, only the decision, and always leaves a door open: self-hosting\n\tneeds no approval from anyone.\n-->\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#F6F8FF;\">\n\t<tr>\n\t\t<td align=\"center\" style=\"padding:24px 12px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;\">\n\t\t\t<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:600px;background-color:#FFFFFF;border:1px solid #DFE7FA;border-radius:14px;\">\n\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:20px 28px;background-color:#0A1024;border-radius:13px 13px 0 0;\">\n\t\t\t\t\t\t<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td width=\"10\" bgcolor=\"#4E8BFB\" style=\"width:10px;height:10px;border-radius:3px;font-size:0;line-height:10px;\">&nbsp;</td>\n\t\t\t\t\t\t\t\t<td style=\"padding-left:12px;font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif;font-size:17px;font-weight:800;letter-spacing:0.04em;color:#FFFFFF;\">BENCHPRESS</td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t</table>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:30px 28px 0;\">\n\t\t\t\t\t\t<div style=\"font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#8B94AE;\">Access request {{ reference | e }}</div>\n\t\t\t\t\t\t<h1 style=\"margin:10px 0 0;font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif;font-size:24px;line-height:32px;font-weight:800;color:#0A1024;\">Not this time, {{ full_name | e }}.</h1>\n\t\t\t\t\t\t<p style=\"margin:14px 0 0;font-size:15px;line-height:24px;color:#4E5A7C;\">We are not opening a hosted account for {{ email | e }}. You asked for a plain answer rather than silence, so here it is — and you are welcome to ask again later.</p>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\n\t\t\t\t{% if rejection_reason %}\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:22px 28px 0;\">\n\t\t\t\t\t\t<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#F6F8FF;border-left:3px solid #C9D6F4;border-radius:0 10px 10px 0;\">\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td style=\"padding:14px 18px;\">\n\t\t\t\t\t\t\t\t\t<div style=\"font-size:11px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#8B94AE;\">Why</div>\n\t\t\t\t\t\t\t\t\t<div style=\"padding-top:6px;font-size:14px;line-height:22px;color:#0A1024;\">{{ rejection_reason }}</div>\n\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t</table>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\t\t\t\t{% endif %}\n\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:26px 28px 0;\">\n\t\t\t\t\t\t<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#0A1024;border-radius:12px;\">\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td style=\"padding:20px 22px;\">\n\t\t\t\t\t\t\t\t\t<div style=\"font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif;font-size:16px;line-height:24px;font-weight:700;color:#FFFFFF;\">The software is still yours.</div>\n\t\t\t\t\t\t\t\t\t<p style=\"margin:8px 0 0;font-size:14px;line-height:22px;color:#9FC3FF;\">BenchPress is AGPL-3.0. Self-hosting is the same code, needs no account and no approval, and has no ceiling on labs — point it at your own Docker daemon and every container stays in-house.</p>\n\t\t\t\t\t\t\t\t\t<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-top:16px;\">\n\t\t\t\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t\t\t\t<td bgcolor=\"#1F5CF5\" style=\"border-radius:10px;\">\n\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"{{ repo_url | e }}\" style=\"display:inline-block;padding:12px 20px;font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif;font-size:14px;font-weight:700;color:#FFFFFF;text-decoration:none;\">Read the repo</a>\n\t\t\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t\t\t</table>\n\t\t\t\t\t\t\t\t\t<p style=\"margin:12px 0 0;font-family:'SFMono-Regular',Consolas,Menlo,monospace;font-size:12px;line-height:19px;color:#9FC3FF;\"><a href=\"{{ repo_url | e }}\" style=\"color:#9FC3FF;text-decoration:none;\">{{ repo_url | e }}</a></p>\n\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t</table>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:22px 28px 0;\">\n\t\t\t\t\t\t<p style=\"margin:0;font-size:14px;line-height:22px;color:#4E5A7C;\">The install path is written down in the documentation: <a href=\"{{ docs_url | e }}\" style=\"color:#1F5CF5;text-decoration:underline;\">{{ docs_url | e }}</a></p>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:24px 28px 0;\">\n\t\t\t\t\t\t<div style=\"height:1px;background-color:#E3EAFB;line-height:1px;font-size:0;\">&nbsp;</div>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:16px 28px 26px;\">\n\t\t\t\t\t\t<p style=\"margin:0;font-size:12px;line-height:19px;color:#8B94AE;\">Frappe and ERPNext are trademarks of Frappe Technologies Pvt. Ltd. BenchPress is an independent project, not affiliated with Frappe Technologies.</p>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\n\t\t\t</table>\n\t\t</td>\n\t</tr>\n</table>\n"
 },
