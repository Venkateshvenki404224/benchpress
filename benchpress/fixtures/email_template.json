t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td width=\"150\" style=\"padding:9px 0;border-bottom:1px solid #E3EAFB;font-size:13px;line-height:20px;color:#8B94AE;\">Apps expected</td>\n\t\t\t\t\t\t\t\t<td style=\"padding:9px 0;border-bottom:1px solid #E3EAFB;font-size:14px;line-height:20px;color:#0A1024;\">{{ expected_apps | e or \"&mdash;\" }}</td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td width=\"150\" valign=\"top\" style=\"padding:9px 0;border-bottom:1px solid #E3EAFB;font-size:13px;line-height:20px;color:#8B94AE;\">Use case</td>\n\t\t\t\t\t\t\t\t<td style=\"padding:9px 0;border-bottom:1px solid #E3EAFB;font-size:14px;line-height:20px;color:#0A1024;\">{{ use_case or \"&mdash;\" }}</td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t</table>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:26px 28px 0;\">\n\t\t\t\t\t\t<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td bgcolor=\"#1F5CF5\" style=\"border-radius:10px;\">\n\t\t\t\t\t\t\t\t\t<a href=\"{{ desk_url | e }}\" style=\"display:inline-block;padding:13px 22px;font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif;font-size:15px;font-weight:700;color:#FFFFFF;text-decoration:none;\">Open in Desk</a>\n\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t</table>\n\t\t\t\t\t\t<p style=\"margin:12px 0 0;font-family:'SFMono-Regular',Consolas,Menlo,monospace;font-size:12px;line-height:19px;color:#8B94AE;\"><a href=\"{{ desk_url | e }}\" style=\"color:#8B94AE;text-decoration:none;\">{{ desk_url | e }}</a></p>\n\t\t\t\t\t\t<p style=\"margin:10px 0 0;font-size:13px;line-height:20px;color:#8B94AE;\">Approve or decline from the list view; both actions mail the requester.</p>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:24px 28px 0;\">\n\t\t\t\t\t\t<div style=\"height:1px;background-color:#E3EAFB;line-height:1px;font-size:0;\">&nbsp;</div>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:16px 28px 26px;\">\n\t\t\t\t\t\t<p style=\"margin:0;font-size:12px;line-height:19px;color:#8B94AE;\">Sent by <a href=\"{{ site_url | e }}\" style=\"color:#4E5A7C;text-decoration:underline;\">BenchPress</a> to everyone holding an admin role on this site.</p>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\n\t\t\t</table>\n\t\t</td>\n\t</tr>\n</table>\n"
