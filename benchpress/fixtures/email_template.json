  "response_html": "<!--\n\tBenchPress Contact Message Received — acknowledgement to the sender.\n\n\tEchoes the message back so the sender has a copy of what left their hands, and names the\n\tresponse window rather than promising \"soon\".\n-->\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color:#F6F8FF;\">\n\t<tr>\n\t\t<td align=\"center\" style=\"padding:24px 12px;font-family:-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;\">\n\t\t\t<table role=\"presentation\" width=\"600\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"width:100%;max-width:600px;background-color:#FFFFFF;border:1px solid #DFE7FA;border-radius:14px;\">\n\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:20px 28px;background-color:#0A1024;border-radius:13px 13px 0 0;\">\n\t\t\t\t\t\t<table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td width=\"10\" bgcolor=\"#4E8BFB\" style=\"width:10px;height:10px;border-radius:3px;font-size:0;line-height:10px;\">&nbsp;</td>\n\t\t\t\t\t\t\t\t<td style=\"padding-left:12px;font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif;font-size:17px;font-weight:800;letter-spacing:0.04em;color:#FFFFFF;\">BENCHPRESS</td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t</table>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:30px 28px 0;\">\n\t\t\t\t\t\t<div style=\"font-size:12px;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#1F5CF5;\">Message received</div>\n\t\t\t\t\t\t<h1 style=\"margin:10px 0 0;font-family:'Poppins','Segoe UI',Helvetica,Arial,sans-serif;font-size:24px;line-height:32px;font-weight:800;color:#0A1024;\">Thanks, {{ sender_name | e }} — it landed.</h1>\n\t\t\t\t\t\t<p style=\"margin:14px 0 0;font-size:15px;line-height:24px;color:#4E5A7C;\">A person answers these, not a ticket robot.{% if response_window %} For {{ topic | e or \"a message like this\" }} the usual turnaround is {{ response_window | e }}.{% endif %}</p>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:24px 28px 0;\">\n\t\t\t\t\t\t<div style=\"font-size:12px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#0A1024;\">Your copy</div>\n\t\t\t\t\t\t<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-top:10px;background-color:#F6F8FF;border:1px solid #E3EAFB;border-radius:10px;\">\n\t\t\t\t\t\t\t<tr>\n\t\t\t\t\t\t\t\t<td style=\"padding:16px 18px;\">\n\t\t\t\t\t\t\t\t\t{% if topic %}\n\t\t\t\t\t\t\t\t\t<div style=\"font-size:12px;font-weight:700;letter-spacing:0.08em;text-transform:uppercase;color:#1F5CF5;\">{{ topic | e }}</div>\n\t\t\t\t\t\t\t\t\t{% endif %}\n\t\t\t\t\t\t\t\t\t<div style=\"padding-top:8px;font-size:14px;line-height:22px;color:#0A1024;\">{{ message }}</div>\n\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t</table>\n\t\t\t\t\t\t<p style=\"margin:10px 0 0;font-size:13px;line-height:20px;color:#8B94AE;\">Replying to this email reaches the same thread.</p>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:24px 28px 0;\">\n\t\t\t\t\t\t<p style=\"margin:0;font-size:14px;line-height:22px;color:#4E5A7C;\">If it turns out to be a bug or a self-hosting question, the fastest door is GitHub issues — those get answered in public where the next person can read them.</p>\n\t\t\t\t\t\t<p style=\"margin:8px 0 0;font-family:'SFMono-Regular',Consolas,Menlo,monospace;font-size:12px;line-height:19px;color:#8B94AE;\"><a href=\"{{ repo_url | e }}/issues\" style=\"color:#8B94AE;text-decoration:none;\">{{ repo_url | e }}/issues</a></p>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:24px 28px 0;\">\n\t\t\t\t\t\t<div style=\"height:1px;background-color:#E3EAFB;line-height:1px;font-size:0;\">&nbsp;</div>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\t\t\t\t<tr>\n\t\t\t\t\t<td style=\"padding:16px 28px 26px;\">\n\t\t\t\t\t\t<p style=\"margin:0;font-size:12px;line-height:19px;color:#8B94AE;\">Sent by <a href=\"{{ site_url | e }}\" style=\"color:#4E5A7C;text-decoration:underline;\">BenchPress</a> because this address was used on the contact form. Frappe and ERPNext are trademarks of Frappe Technologies Pvt. Ltd.</p>\n\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\n\t\t\t</table>\n\t\t</td>\n\t</tr>\n</table>\n"
 },
